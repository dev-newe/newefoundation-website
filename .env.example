# Database
DATABASE_URI=mongodb+srv://user:pass@cluster.mongodb.net/org-website-dev

# Payload
PAYLOAD_SECRET=replace-with-long-random-string

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=newefoundation
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=org-website-dev

# Resend
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_your_test_key_here
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=